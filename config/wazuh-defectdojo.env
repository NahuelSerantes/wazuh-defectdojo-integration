# Wazuh Indexer
WAZUH_INDEXER_URL="https://localhost:9200"
WAZUH_NETRC="/root/.netrc"
WAZUH_INDEX_PATTERN="wazuh-states-vulnerabilities*"

# DefectDojo
DEFECTDOJO_URL="http://defectdojo.example:8080"
DEFECTDOJO_API_KEY="REEMPLAZAR_CON_TOKEN"
DEFECTDOJO_PRODUCT_TYPE_NAME="Infrastructure"
DEFECTDOJO_PRODUCT_NAME="Wazuh Server"
DEFECTDOJO_ENGAGEMENT_NAME="Wazuh Monitoring"

# Importación
MINIMUM_SEVERITY="Info"
TEST_TITLE="Wazuh Vulnerabilities"

# Vacío importa todos los agentes. Ejemplo: AGENT_ID="001"
AGENT_ID=""

# Cantidad de documentos solicitados por página al Indexer
PAGE_SIZE="1000"
